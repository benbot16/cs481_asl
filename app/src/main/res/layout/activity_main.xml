<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/textWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:background="#C3CCD0"
            android:gravity="center"
            android:text="Welcome to\nSign 2 Speak"
            android:textColor="@color/black"
            android:textSize="50sp"
            android:fontFamily="casual"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxHeight="70dp"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/asllogo" />
        <TextView
            android:id="@+id/textAppDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="American Sign Language (ASL) serves as the primary language for the deaf
community in America. ASL uses hand gestures for communication. Sign2Speak
allows users to translate hand gestures to written and spoken English in real time."
            android:textSize="25sp"
            android:textColor="@color/black"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical"
            android:padding="5dp"
            android:background="#D3E4FA"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="0dp">
            <TextView
                android:id="@+id/textGettingStarted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:text="Getting Started:"
                android:textColor="@color/black"
                android:textSize="30sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSigns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:padding="15dp"
                android:text="Translatable Signs"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:backgroundTint="#6E91BA"
                tools:layout_editor_absoluteX="64dp"
                tools:layout_editor_absoluteY="644dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonHowTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:padding="15dp"
                android:backgroundTint="#6E91BA"
                android:text="How to Translate Gestures"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="64dp"
                tools:layout_editor_absoluteY="644dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStartSigning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:padding="15dp"
                android:backgroundTint="#6E91BA"
                android:text="Start Signing"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="64dp"
                tools:layout_editor_absoluteY="644dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>